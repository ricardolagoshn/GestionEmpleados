<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!--
    En rutas largas de Windows (por ejemplo, carpetas de OneDrive) la DLL nativa de SqlClient
    supera MAX_PATH y no puede cargarse. En ese caso bin/obj se ubican en %LOCALAPPDATA%.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And $(MSBuildThisFileDirectory.Length) &gt; 100">
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(LOCALAPPDATA)\GestionEmpleados\artifacts</ArtifactsPath>
    <!-- Ignora carpetas bin/obj locales que hayan quedado de compilaciones anteriores. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
